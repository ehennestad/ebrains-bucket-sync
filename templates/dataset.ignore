# Exclude patterns for publishing a dataset. Copy this file, add the
# patterns of your dataset, and pass it to a sync:
#
#     ebrains-bucket-sync push my-dataset my-bucket --exclude-from dataset.ignore
#
# A pattern without "/" leaves out files and folders of that name in every
# folder. A pattern with "/" in front of it or inside it is matched from the
# root of the synced folder, so "/build" leaves out the build folder at the
# root only. A trailing "/" is ignored, so ".git/" leaves out every ".git"
# folder, and a file of that name too. The rules are those of
# spec/README.md, which lists where they differ from a .gitignore file. A
# line that starts with "!" is refused.

# Version control
.git/
.gitignore
.gitattributes
.gitmodules
.svn/
.hg/

# Operating system files
.DS_Store
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# MATLAB
*.asv
*.m~

# R
.Rhistory
.Rproj.user/

# Editors
.vscode/
.idea/
*.swp
*~

# Office lock files
~$*

# Secrets, such as tokens and passwords
.env
